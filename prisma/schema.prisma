generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String
  password       String
  isPrivate      Boolean          @default(false)
  itineraries    Itinerary[]
  following      Follow[]         @relation("UserFollowing")
  followers      Follow[]         @relation("UserFollowers")
  bucketList     BucketListItem[]
  savedFolders   SavedFolder[]
  comments       Comment[]
  notifications Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")
  pushDevices PushDevice[]
  sentMessages DirectMessage[] @relation("MessageSender")
  receivedMessages DirectMessage[] @relation("MessageRecipient")
  savedImportNotes SavedImportNotes[]
  stories Story[]
  questions FriendQuestion[]
  questionReplies FriendQuestionReply[]
  createdAt      DateTime         @default(now())
}

model SavedImportNotes {
  id String @id @default(cuid())
  userId String
  text String @db.Text
  digest String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, digest])
  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Itinerary {
  id           String           @id @default(cuid())
  title        String
  description  String?
  isPlan       Boolean          @default(false)
  datesFlexible Boolean         @default(false)
  startDate    DateTime
  endDate      DateTime
  postType     String           @default("itinerary")
  audience     String           @default("family")
  visibility   String           @default("public")
  notes        String?
  highlights   String?
  tags         String[] @default([])
  bestMonths   String[] @default([])
  budget       Int?
  tripRating   Int?
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  destinations Destination[]
  photos       Photo[]
  bucketedBy   BucketListItem[]
  comments     Comment[]
  notifications Notification[]
  stories Story[]
  createdAt    DateTime         @default(now())
}

model BucketListItem {
  id          String    @id @default(cuid())
  userId      String
  itineraryId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      SavedFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, itineraryId])
  @@index([folderId])
}

model SavedFolder {
  id        String @id @default(cuid())
  userId    String
  name      String @db.VarChar(80)
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     BucketListItem[]

  @@unique([userId, name])
}

model Destination {
  id          String     @id @default(cuid())
  name        String
  country     String?
  notes       String?
  lat         Float?
  lng         Float?
  order       Int        @default(0)
  itineraryId String
  itinerary   Itinerary  @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  items       DestItem[]
}

// type: "activity" | "food_drink" | "hotel"
// mealType (food_drink only): "lunch" | "dinner" | "drinks" | null
model DestItem {
  id            String      @id @default(cuid())
  type          String
  planningStatus String     @default("considering")
  mealType      String?
  name          String
  description   String?
  notes         String?
  address       String?
  rating        Int?
  priceLevel    Int?
  familyFriendly       Boolean?
  familyFriendlySource String?
  link          String?
  groupIndex    Int         @default(0)
  dayIndex      Int?
  order         Int         @default(0)
  tags          String[]    @default([])
  alternative   String?
  photoUrl      String?
  photoUrls     String[]    @default([])
  placeId       String?
  lat           Float?
  lng           Float?
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  stories Story[]
}

model Photo {
  id          String    @id @default(cuid())
  url         String
  caption     String?
  isStock     Boolean   @default(false)
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

model Comment {
  id          String    @id @default(cuid())
  content     String
  userId      String
  itineraryId String
  parentId    String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")
  notification Notification?
}

model Notification {
  id String @id @default(cuid())
  recipientId String
  actorId String
  itineraryId String?
  kind String
  dedupeKey String @unique
  commentId String? @unique
  messageId String? @unique
  readAt DateTime?
  createdAt DateTime @default(now())
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor User @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  itinerary Itinerary? @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  message DirectMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([recipientId, readAt, createdAt])
}

model PushDevice {
  id String @id @default(cuid())
  userId String
  token String @unique
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DirectMessage {
  id String @id @default(cuid())
  senderId String
  recipientId String
  content String @db.VarChar(4000)
  clientId String
  itineraryId String?
  itineraryTitle String?
  placeId String?
  placeName String?
  placeNotes String?
  replyToId String?
  replyTo DirectMessage? @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies DirectMessage[] @relation("MessageReplies")
  createdAt DateTime @default(now())
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notification Notification?

  @@unique([senderId, clientId])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, createdAt])
  @@index([replyToId])
}

model FriendQuestion {
  id String @id @default(cuid())
  authorId String
  content String @db.VarChar(4000)
  clientId String
  itineraryId String?
  itineraryTitle String?
  createdAt DateTime @default(now())
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies FriendQuestionReply[]

  @@unique([authorId, clientId])
  @@index([authorId, createdAt, id])
}

model FriendQuestionReply {
  id String @id @default(cuid())
  questionId String
  authorId String
  content String @db.VarChar(4000)
  clientId String
  itineraryId String?
  itineraryTitle String?
  createdAt DateTime @default(now())
  question FriendQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, clientId])
  @@index([questionId, createdAt, id])
}

model Story {
  id String @id
  userId String
  sourceItineraryId String?
  sourceItemId String?
  placeName String
  destination String
  country String?
  type String
  placeId String?
  lat Float?
  lng Float?
  photoUrl String
  caption String @db.VarChar(500)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceItinerary Itinerary? @relation(fields: [sourceItineraryId], references: [id], onDelete: SetNull)
  sourceItem DestItem? @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([userId, createdAt])
}
