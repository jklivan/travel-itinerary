generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                @id @default(cuid())
  email             String                @unique
  name              String
  password          String
  isPrivate         Boolean               @default(false)
  // Profile photo (an /api/img link to a private upload); initials show when empty.
  image             String?
  // Sign-up's "your best vacation": { destination, travelers, hotel, tags, savedAt }. The trip planner leans on it until
  // they've added trips of their own, then weighs it like one of them.
  bestVacation      Json?
  itineraries       Itinerary[]
  following         Follow[]              @relation("UserFollowing")
  followers         Follow[]              @relation("UserFollowers")
  bucketList        BucketListItem[]
  tripLikes         TripLike[]
  savedFolders      SavedFolder[]
  comments          Comment[]
  notifications     Notification[]        @relation("NotificationRecipient")
  sentNotifications Notification[]        @relation("NotificationActor")
  pushDevices       PushDevice[]
  sentMessages      DirectMessage[]       @relation("MessageSender")
  receivedMessages  DirectMessage[]       @relation("MessageRecipient")
  savedImportNotes  SavedImportNotes[]
  stories           Story[]
  questions         FriendQuestion[]
  questionReplies   FriendQuestionReply[]
  planChats         PlanChat[]
  placesSharedFrom  DestItem[]            @relation("PlaceSource")
  reportsMade       Report[]              @relation("ReportReporter")
  reportsAbout      Report[]              @relation("ReportSubject")
  blocking          Block[]               @relation("BlockBlocker")
  blockedBy         Block[]               @relation("BlockBlocked")
  // "Send trips to Postcard": the private part of this person's address (trips-<inboxToken>@in.postcardtravel.app),
  // and other addresses besides their account email that may send to it (their assistant's, a work email).
  inboxToken        String?               @unique @db.VarChar(40)
  inboxSenders      String[]              @default([])
  oauthCodes        OAuthCode[]
  oauthTokens       OAuthToken[]
  createdAt         DateTime              @default(now())
}

model SavedImportNotes {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.Text
  digest    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, digest])
  @@index([userId, createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}

model Itinerary {
  id               String           @id @default(cuid())
  title            String
  description      String?
  isPlan           Boolean          @default(false)
  durationDays     Int?
  datesFlexible    Boolean          @default(false)
  startDate        DateTime
  endDate          DateTime
  postType         String           @default("itinerary")
  audience         String           @default("family")
  visibility       String           @default("public")
  notes            String?
  highlights       String?
  tags             String[]         @default([])
  bestMonths       String[]         @default([])
  budget           Int?
  tripRating       Int?
  userId           String
  user             User             @relation(fields: [userId], references: [id])
  destinations     Destination[]
  photos           Photo[]
  // The photo chosen as the trip's cover (one of its trip or place photos); empty = first photo.
  coverPhoto       String?
  // How the cover is framed in the feed's 4:3 frame: "x,y,zoom" (centre in %, zoom 1–3); empty = centred.
  coverFocus       String?          @db.VarChar(20)
  bucketedBy       BucketListItem[]
  likes            TripLike[]
  comments         Comment[]
  notifications    Notification[]
  stories          Story[]
  planChats        PlanChat[]
  placesCopiedFrom DestItem[]       @relation("PlaceSource")
  createdAt        DateTime         @default(now())
  publishedAt      DateTime?
}

model BucketListItem {
  id          String       @id @default(cuid())
  userId      String
  itineraryId String
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary   Itinerary    @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  folderId    String?
  folder      SavedFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, itineraryId])
  @@index([folderId])
}

// A public "I liked this" on a trip (the heart). Saving to folders is separate (BucketListItem).
model TripLike {
  id          String    @id @default(cuid())
  userId      String
  itineraryId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@unique([userId, itineraryId])
  @@index([itineraryId])
}

model SavedFolder {
  id        String           @id @default(cuid())
  userId    String
  name      String           @db.VarChar(80)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     BucketListItem[]

  @@unique([userId, name])
}

model Destination {
  id          String     @id @default(cuid())
  name        String
  country     String?
  notes       String?
  lat         Float?
  lng         Float?
  order       Int        @default(0)
  // How many days of the trip are spent here (optional, set when planning day by day).
  days        Int?
  itineraryId String
  itinerary   Itinerary  @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  items       DestItem[]
}

// type: "activity" | "food_drink" | "hotel"
// mealType (food_drink only): "lunch" | "dinner" | "drinks" | null
model DestItem {
  id                   String      @id @default(cuid())
  type                 String
  planningStatus       String      @default("considering")
  mealType             String?
  name                 String
  description          String?
  notes                String?
  address              String?
  rating               Int?
  priceLevel           Int?
  familyFriendly       Boolean?
  familyFriendlySource String?
  link                 String?
  groupIndex           Int         @default(0)
  dayIndex             Int?
  // Hotels: nights booked, starting on the hotel's day (its check-in).
  nights               Int?
  // The booking's real date and time, as written locally where it happens (no time zone): a dinner on
  // 2026-04-05 at "19:30", a hotel from date (check-in) to endDate (check-out), a flight leaving at time and
  // landing at endDate/endTime. Times are 24-hour "HH:MM".
  date                 DateTime?   @db.Date
  time                 String?
  endDate              DateTime?   @db.Date
  endTime              String?
  // Private to the trip's owner, never shown to anyone else or on a posted trip: confirmation numbers, seats,
  // booking references. Hidden from every query by default (lib/prisma); only the owner's planner, edit form and
  // itinerary PDF read it.
  bookingDetails       String?
  order                Int         @default(0)
  tags                 String[]    @default([])
  alternative          String?
  photoUrl             String?
  photoUrls            String[]    @default([])
  placeId              String?
  lat                  Float?
  lng                  Float?
  destinationId        String
  destination          Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  stories              Story[]
  // Where the idea came from, for places copied into a plan: "trip" (someone's trip), "snapshot" or "ai" (Plan with AI).
  // The trip and person are cleared if they're deleted; the kind stays.
  sourceKind           String?
  sourceItineraryId    String?
  sourceItinerary      Itinerary?  @relation("PlaceSource", fields: [sourceItineraryId], references: [id], onDelete: SetNull)
  sourceUserId         String?
  sourceUser           User?       @relation("PlaceSource", fields: [sourceUserId], references: [id], onDelete: SetNull)
}

model Photo {
  id          String    @id @default(cuid())
  url         String
  caption     String?
  isStock     Boolean   @default(false)
  itineraryId String
  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
}

model Comment {
  id           String        @id @default(cuid())
  content      String
  userId       String
  itineraryId  String
  parentId     String?
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary    Itinerary     @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  parent       Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      Comment[]     @relation("CommentReplies")
  notification Notification?
}

model Notification {
  id              String               @id @default(cuid())
  recipientId     String
  actorId         String
  itineraryId     String?
  kind            String
  dedupeKey       String               @unique
  commentId       String?              @unique
  messageId       String?              @unique
  questionId      String?
  questionReplyId String?              @unique
  readAt          DateTime?
  createdAt       DateTime             @default(now())
  recipient       User                 @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor           User                 @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  itinerary       Itinerary?           @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  comment         Comment?             @relation(fields: [commentId], references: [id], onDelete: Cascade)
  message         DirectMessage?       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  question        FriendQuestion?      @relation(fields: [questionId], references: [id], onDelete: Cascade)
  questionReply   FriendQuestionReply? @relation(fields: [questionReplyId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([recipientId, readAt, createdAt])
}

model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DirectMessage {
  id             String          @id @default(cuid())
  senderId       String
  recipientId    String
  content        String          @db.VarChar(4000)
  clientId       String
  itineraryId    String?
  itineraryTitle String?
  placeId        String?
  placeName      String?
  placeNotes     String?
  replyToId      String?
  replyTo        DirectMessage?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        DirectMessage[] @relation("MessageReplies")
  createdAt      DateTime        @default(now())
  sender         User            @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User            @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  notification   Notification?

  @@unique([senderId, clientId])
  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, createdAt])
  @@index([replyToId])
}

model FriendQuestion {
  id             String                @id @default(cuid())
  authorId       String
  content        String                @db.VarChar(4000)
  clientId       String
  itineraryId    String?
  itineraryTitle String?
  createdAt      DateTime              @default(now())
  author         User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies        FriendQuestionReply[]
  notifications  Notification[]

  @@unique([authorId, clientId])
  @@index([authorId, createdAt, id])
}

model FriendQuestionReply {
  notification   Notification?
  id             String         @id @default(cuid())
  questionId     String
  authorId       String
  content        String         @db.VarChar(4000)
  clientId       String
  itineraryId    String?
  itineraryTitle String?
  createdAt      DateTime       @default(now())
  question       FriendQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([authorId, clientId])
  @@index([questionId, createdAt, id])
}

model Story {
  id                String     @id
  userId            String
  sourceItineraryId String?
  sourceItemId      String?
  placeName         String
  destination       String
  country           String?
  type              String
  placeId           String?
  lat               Float?
  lng               Float?
  photoUrl          String
  caption           String     @db.VarChar(500)
  // True when posting this snapshot put its photo onto the place, so deleting the snapshot removes it again.
  photoAddedToPlace Boolean    @default(false)
  createdAt         DateTime   @default(now())
  expiresAt         DateTime
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceItinerary   Itinerary? @relation(fields: [sourceItineraryId], references: [id], onDelete: SetNull)
  sourceItem        DestItem?  @relation(fields: [sourceItemId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@index([userId, createdAt])
}

// Conversation with Claude on the /testplan page. `history` is the raw Messages API history (resent verbatim);
// `turns` is the display version with recommendation cards.
model PlanChat {
  id        String     @id @default(cuid())
  userId    String
  tripId    String?
  history   Json       @default("[]")
  turns     Json       @default("[]")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip      Itinerary? @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId, tripId, updatedAt])
}

// Someone flagging content or a person as objectionable (App Store guideline 1.2). Reviewed on the admin page.
// kind: "trip" | "comment" | "message" | "snapshot" | "question" | "user"; targetId is that thing's id.
// subjectId is whose content it is. status: "open" until handled.
model Report {
  id         String    @id @default(cuid())
  reporterId String
  subjectId  String?
  kind       String
  targetId   String
  reason     String
  details    String?   @db.VarChar(1000)
  status     String    @default("open")
  createdAt  DateTime  @default(now())
  handledAt  DateTime?
  reporter   User      @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  subject    User?     @relation("ReportSubject", fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

// A person you've blocked: their trips, comments, snapshots and messages are hidden from you, follows between
// you are removed, and they can't message you.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// AI assistants (Muse, ChatGPT, Claude) connected to Postcard through its connector (/api/mcp). Each assistant
// registers itself once; the person signs in and allows it, and it gets keys that only work for that person.
model OAuthClient {
  id           String       @id @default(cuid())
  name         String       @db.VarChar(200)
  redirectUris String[]
  createdAt    DateTime     @default(now())
  codes        OAuthCode[]
  tokens       OAuthToken[]
}

// A one-time sign-in code, swapped for keys within minutes (stored hashed).
model OAuthCode {
  id            String      @id @default(cuid())
  codeHash      String      @unique
  clientId      String
  userId        String
  redirectUri   String
  codeChallenge String
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// An assistant's key for one person: "access" (short-lived) or "refresh" (to get new ones). Stored hashed;
// disconnecting an assistant revokes all of its keys.
model OAuthToken {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  kind       String      @db.VarChar(10)
  clientId   String
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime    @default(now())
  client     OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, clientId])
}
